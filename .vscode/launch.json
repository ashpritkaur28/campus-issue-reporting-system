{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Campus Issue Reporting System",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "server.ts"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PORT": "3000"
      },
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
